# Docker 部署配置（复制为 .env）
# 本仓库发布的 Docker Hub 镜像地址；参见 README 的部署说明。
ARTEX_IMAGE=ruoji6/artex
ARTEX_TAG=latest
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# 汉化镜像（见 README-zh-cn.md）。留空 = 用本地构建的 artex-zh:local；
# 填上则用预编译镜像（其他服务器推荐，无需本地编译）。
# ARTEX_ZH_IMAGE=ghcr.io/linyueying/artex-zh-cn:latest

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=
